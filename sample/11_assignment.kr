/*
 * 11_assignment.kr: initializations and assignments of literals and variables. A name already
 * declared gets a new value with the same sentence as its declaration.
 * main returns 7: `echo $?` prints 7 after the run.
 */

정수를 반환하는 main() {
    가는 1이에요.
    나는 2예요.
    가는 7이에요.
    나는 가예요.
    나를 반환해요.
}
